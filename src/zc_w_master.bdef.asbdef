projection;
strict ( 2 );
use draft;

define behavior for ZC_W_MASTER alias WricefMaster
{
  use create;
  use update;
  use delete;

  use action changeStatus;
  use action changePlanFinish;
  use action getWricef;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Owner { create; with draft; }
  use association _Object { create; with draft; }
  use association _Transport { create; with draft; }
}

define behavior for ZC_W_OBJECT alias Object
{
  use update;
  use delete;

  use association _WricefMaster { with draft; }
}

define behavior for ZC_W_OWNER alias Owner
{
  use update;
  use delete;

  use association _WricefMaster { with draft; }
}

define behavior for ZC_W_TRANSPORT alias Transport
{
  use update;
  use delete;

  use association _WricefMaster { with draft; }
}